# Скопируйте в .env и поменяйте значения при необходимости.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=0

# База и загрузки. Для production задайте абсолютные пути на persistent volume.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Используются только командой `npm run admin:create`.
# Не коммитьте реальный пароль.
ADMIN_EMAIL=
ADMIN_PASSWORD=
